{
  "libraryName": "Matt Blackman's TiddlyWiki Plugin Library",
  "libraryDescription": "TiddlyWiki5 plugins and themes by Matt Blackman (@mblackman)",
  "authorHandle": "mblackman",
  "libraryBaseUrl": "https://mblackman.github.io/tw5-plugin-library",
  "repositories": [
    { "repo": "mblackman/tiddlywiki-slipstream" },
    { "repo": "mblackman/tiddlywiki-timelord" },
    { "repo": "mblackman/tiddlywiki-media-importer" },
    { "repo": "mblackman/tiddlywiki-coffee-tracker" },
    { "repo": "mblackman/tiddlywiki-journal" },
    { "repo": "mblackman/Projectify" },
    {
      "repo": "mblackman/tiddlypwa",
      "assetRegex": "^(tiddlypwa|web-app-manifest)\\.json$",
      "serverDependent": true,
      "category": "server-dependent",
      "serverDescription": "Offline-first encrypted PWA sync (requires TiddlyPWA sync server backend)"
    },
    {
      "repo": "mblackman/tiddly-familiar",
      "assetRegex": "^familiar\\.(json|tid)$",
      "serverDependent": true,
      "category": "server-dependent",
      "serverDescription": "Streaming AI chat, semantic search, summaries, and tag/task suggestions (requires self-hosted Familiar gateway)"
    }
  ]
}
